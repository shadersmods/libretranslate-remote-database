{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LibreTranslate instance catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instances"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "url", "sources", "enabled", "probe_translation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
          "enabled": { "type": "boolean" },
          "probe_translation": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
